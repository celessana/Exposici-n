## ABUNDANCIA:
```{r}
library(glmmTMB)
abundancia <- datos_desc %>%
  filter(
    !is.na(Conteo_total),
    !is.na(Vol_efectivo_l),
    Vol_efectivo_l > 0
  ) %>%
  group_by(Laguna, Fecha, Peces, Fraccion, Grupo) %>%
  summarise(
    conteo = sum(Conteo_total),
    Vol_efectivo_l = first(Vol_efectivo_l),
    .groups = "drop"
  )

modelo_abund_pois <- glmmTMB(
  conteo ~ Peces * Fecha + Grupo + Fraccion +
    offset(log(Vol_efectivo_l)) +
    (1 | Laguna),
  family = poisson,
  data = abundancia
)

modelo_abund_nb <- glmmTMB(
  conteo ~ Peces * Fecha + Grupo + Fraccion +
    offset(log(Vol_efectivo_l)) +
    (1 | Laguna),
  family = nbinom2,
  data = abundancia
)
```


--- DESEMPEÑO

```{r, fig.width=12, fig.height=8, out.width="100%"}
library(DHARMa)

# Poisson
res_pois <- simulateResiduals(modelo_abund_pois, n = 1000)
library(DHARMa)
par(mfrow = c(2, 2))
plotResiduals(res_pois, form = fitted(modelo_abund_pois))
plotQQunif(res_pois)
hist(res_pois$scaledResiduals,
     main = "Residuos escalados: Poisson",
     xlab = "Residuos escalados")
plotResiduals(res_pois, form = abundancia$Fecha)
par(mfrow = c(1, 1))

testDispersion(res_pois, plot = FALSE)
```
```{r}
library(DHARMa)
testDispersion(res_pois, plot = FALSE)
```

