## MODELO RIQUEZA 
library(dplyr)
library(ggplot2)

library(glmmTMB)

riqueza_model <- riqueza %>%
  mutate(
    Laguna = factor(Laguna),
    Peces = factor(Peces, levels = c("No", "Si")),
    Fecha = factor(
      Fecha,
      levels = c("Diciembre_2023", "Febrero_2024")
    )
  )

modelo_riqueza <- glmmTMB(
  Riqueza ~ Peces * Fecha + (1 | Laguna),
  family = poisson(link = "log"),
  data = riqueza_model
)

summary(modelo_riqueza)

riqueza
```
----
# PLOTS:
```{r, fig.width=12, fig.height=8, out.width="100%"}
residuos <- DHARMa::simulateResiduals(modelo_riqueza)

par(mfrow = c(2, 2))
library(DHARMa)
plotResiduals(residuos, form = fitted(modelo_riqueza))
plotQQunif(residuos)
hist(residuos$scaledResiduals,
     main = "Distribución de residuos",
     xlab = "Residuos escalados")
plotResiduals(residuos, form = riqueza_model$Fecha)

par(mfrow = c(1, 1))
```
